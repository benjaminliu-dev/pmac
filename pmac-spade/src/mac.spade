
entity mac(
    clk: clock,
    rst_n: bool,
    en_n: bool, 
    bias: int<8>,
    di_a: int<8>,
    di_b: int<8>
) -> int<24> {

    let product: int<16> = di_a * di_b;
    let product_ext: int<24> = sext(product);
    let bias_ext: int<24> = sext(bias);
    let term: int<24> = trunc(product_ext + bias_ext);

    reg(clk) acc: int<24> reset(!rst_n: 0) = if !en_n {
        trunc(acc + term)
    } else {
        acc
    };
    acc
}